              <div className="flex items-center justify-between border-b border-slate-800 pb-4">
                <div>
                  <h3 className="font-bold text-base text-slate-100">{agents[selectedAgentNode].name} Tuning Studio</h3>
                  <p className="text-xs text-slate-400">Adjust system prompts, model temperature, and consensus weight in the decision engine.</p>
                </div>
                <button
                  onClick={() => alert('Agent parameters updated successfully!')}
                  className="px-4 py-2 bg-emerald-500 text-slate-950 font-bold rounded-lg text-xs hover:bg-emerald-400 transition-colors"
                >
                  Save Configuration
                </button>
              </div>

              {/* System Prompt Textarea */}
              <div className="space-y-2">
                <label className="text-xs font-semibold text-slate-300 block">System Persona Prompt:</label>
                <textarea
                  rows={6}
                  value={agents[selectedAgentNode].prompt}
                  onChange={(e) => {
                    const newPrompt = e.target.value;
                    setAgents(prev => ({
                      ...prev,
                      [selectedAgentNode]: { ...prev[selectedAgentNode], prompt: newPrompt }
                    }));
                  }}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-slate-200 font-mono focus:outline-none focus:border-emerald-500 leading-relaxed"
                />
              </div>

              {/* Parameter Sliders */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-xs">
                
                {/* Temperature Slider */}
                <div className="space-y-2 bg-slate-950 p-4 border border-slate-800 rounded-lg">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Temperature:</span>
                    <span className="text-emerald-400 font-bold">{agents[selectedAgentNode].temperature}</span>
                  </div>
                  <input
                    type="range"
                    min="0.0"
                    max="1.0"
                    step="0.05"
                    value={agents[selectedAgentNode].temperature}
                    onChange={(e) => {
                      const val = parseFloat(e.target.value);
                      setAgents(prev => ({
                        ...prev,
                        [selectedAgentNode]: { ...prev[selectedAgentNode], temperature: val }
                      }));
                    }}
                    className="w-full accent-emerald-500"
                  />
                  <p className="text-[10px] text-slate-500">Lower = deterministic, Higher = creative analysis.</p>
                </div>

                {/* Agent Decision Weight */}
                <div className="space-y-2 bg-slate-950 p-4 border border-slate-800 rounded-lg">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Consensus Weight:</span>
                    <span className="text-emerald-400 font-bold">{(agents[selectedAgentNode].weight * 100).toFixed(0)}%</span>
                  </div>
                  <input
                    type="range"
                    min="0.0"
                    max="1.0"
                    step="0.05"
                    value={agents[selectedAgentNode].weight}
                    onChange={(e) => {
                      const val = parseFloat(e.target.value);
                      setAgents(prev => ({
                        ...prev,
                        [selectedAgentNode]: { ...prev[selectedAgentNode], weight: val }
                      }));
                    }}
                    className="w-full accent-emerald-500"
                  />
                  <p className="text-[10px] text-slate-500">Weight priority in final PM signal calculation.</p>
                </div>

                {/* LLM Model Selection */}
                <div className="space-y-2 bg-slate-950 p-4 border border-slate-800 rounded-lg">
                  <span className="text-slate-400 block">Model Engine:</span>
                  <select
                    value={agents[selectedAgentNode].model}
                    onChange={(e) => {
                      const val = e.target.value;
                      setAgents(prev => ({
                        ...prev,
                        [selectedAgentNode]: { ...prev[selectedAgentNode], model: val }
                      }));
                    }}
                    className="w-full bg-slate-900 border border-slate-800 rounded p-2 text-xs text-slate-200 focus:outline-none"
                  >
                    <option value="gemini-3.1-flash-preview">Gemini 3.1 Flash</option>
                    <option value="gpt-4o">GPT-4o (Simulated)</option>
                    <option value="claude-3-5-sonnet">Claude 3.5 Sonnet (Simulated)</option>
                    <option value="llama-3-70b">Llama 3 70B (Simulated)</option>
                  </select>
                </div>

              </div>
            </div>

          </div>
        )}

        {/* ================= TAB 4: RISK GUARDRAILS & CRO RULES ================= */}
        {activeTab === 'risk' && (
          <div className="space-y-6">
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-6">
              <div className="flex items-center space-x-3 border-b border-slate-800 pb-4">
                <div className="p-2 bg-amber-500/10 border border-amber-500/30 rounded-lg text-amber-400">
                  <Shield className="w-6 h-6" />
                </div>
                <div>
                  <h2 className="text-base font-bold text-slate-100">Chief Risk Officer (CRO) Guardrails Engine</h2>
                  <p className="text-xs text-slate-400">Hard programmatic limits enforced before any trade order execution.</p>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 font-mono text-xs">
                
                {/* Rule 1: Max Position Size */}
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-3">
                  <div className="flex items-center justify-between">
                    <span className="text-slate-300 font-bold">Max Position Size</span>
                    <span className="text-amber-400 font-bold text-sm">{riskRules.maxPositionSizePercent}%</span>
                  </div>
                  <input
                    type="range"
                    min="5"
                    max="50"
                    value={riskRules.maxPositionSizePercent}
                    onChange={(e) => setRiskRules(prev => ({ ...prev, maxPositionSizePercent: Number(e.target.value) }))}
                    className="w-full accent-amber-500"
                  />
                  <p className="text-[11px] text-slate-400 leading-normal">
                    Caps maximum allocation of portfolio equity into a single stock or asset.
                  </p>
                </div>

                {/* Rule 2: Max Drawdown Circuit Breaker */}
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-3">
                  <div className="flex items-center justify-between">
                    <span className="text-slate-300 font-bold">Max Drawdown Limit</span>
                    <span className="text-rose-400 font-bold text-sm">{riskRules.maxDrawdownThreshold}%</span>
                  </div>
                  <input
                    type="range"
                    min="3"
                    max="20"
                    step="0.5"
                    value={riskRules.maxDrawdownThreshold}
                    onChange={(e) => setRiskRules(prev => ({ ...prev, maxDrawdownThreshold: Number(e.target.value) }))}
                    className="w-full accent-rose-500"
                  />
                  <p className="text-[11px] text-slate-400 leading-normal">
                    Triggers automated trade freeze if portfolio drawdown exceeds threshold.
                  </p>
                </div>

                {/* Rule 3: Default Stop Loss */}
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-3">
                  <div className="flex items-center justify-between">
                    <span className="text-slate-300 font-bold">Dynamic Stop Loss %</span>
                    <span className="text-emerald-400 font-bold text-sm">{riskRules.defaultStopLossPercent}%</span>
                  </div>
                  <input
                    type="range"
                    min="1"
                    max="10"
                    step="0.5"
                    value={riskRules.defaultStopLossPercent}
                    onChange={(e) => setRiskRules(prev => ({ ...prev, defaultStopLossPercent: Number(e.target.value) }))}
                    className="w-full accent-emerald-500"
                  />
                  <p className="text-[11px] text-slate-400 leading-normal">
                    Automatically attached to every newly opened long position order.
                  </p>
                </div>

                {/* Risk Profile Selection */}
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-3">
                  <span className="text-slate-300 font-bold block">Risk Mode Preset</span>
                  <div className="grid grid-cols-3 gap-2">
                    {['CONSERVATIVE', 'BALANCED', 'AGGRESSIVE'].map(mode => (
                      <button
                        key={mode}
                        onClick={() => setRiskRules(prev => ({ ...prev, riskTolerance: mode }))}
                        className={`py-2 rounded text-[10px] font-bold transition-all ${
                          riskRules.riskTolerance === mode
                            ? 'bg-amber-500 text-slate-950'
                            : 'bg-slate-900 text-slate-400 hover:bg-slate-800'
                        }`}
                      >
                        {mode}
                      </button>
                    ))}
                  </div>
                </div>

                {/* CRO Manual Override Switch */}
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-3 flex flex-col justify-between">
                  <div className="flex items-center justify-between">
                    <span className="text-slate-300 font-bold">CRO Veto Enforcement</span>
                    <input
                      type="checkbox"
                      checked={riskRules.requireCroApproval}
                      onChange={(e) => setRiskRules(prev => ({ ...prev, requireCroApproval: e.target.checked }))}
                      className="w-4 h-4 accent-amber-500 rounded"
                    />
                  </div>
                  <p className="text-[11px] text-slate-400">
                    When enabled, Risk Manager agent retains absolute veto over Portfolio Manager trades.
                  </p>
                </div>

              </div>
            </div>
          </div>
        )}

        {/* ================= TAB 5: AUDIT LOG & OPEN POSITIONS ================= */}
        {activeTab === 'history' && (
          <div className="space-y-6">
            
            {/* Open Positions Table */}
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4">
              <h2 className="font-bold text-sm text-slate-200 uppercase tracking-wide flex items-center space-x-2">
                <PieChart className="w-4 h-4 text-emerald-400" />
                <span>Active Portfolio Positions</span>
              </h2>

              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse font-mono text-xs">
                  <thead>
                    <tr className="border-b border-slate-800 text-slate-400">
                      <th className="py-3 px-4">TICKER</th>
                      <th className="py-3 px-4">SHARES</th>
                      <th className="py-3 px-4">ENTRY PRICE</th>
                      <th className="py-3 px-4">CURRENT PRICE</th>
                      <th className="py-3 px-4">STOP LOSS</th>
                      <th className="py-3 px-4">UNREALIZED P&L</th>
                      <th className="py-3 px-4 text-right">ACTION</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60 text-slate-200">
                    {positions.map((pos) => (
                      <tr key={pos.id} className="hover:bg-slate-800/40">
                        <td className="py-3 px-4 font-bold text-emerald-400">{pos.ticker}</td>
                        <td className="py-3 px-4">{pos.shares}</td>
                        <td className="py-3 px-4">${pos.entryPrice.toFixed(2)}</td>
                        <td className="py-3 px-4">${pos.currentPrice.toFixed(2)}</td>
                        <td className="py-3 px-4 text-amber-400">${pos.stopLoss.toFixed(2)}</td>
                        <td className={`py-3 px-4 font-bold ${pos.pnl >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
                          {pos.pnl >= 0 ? '+' : ''}${pos.pnl.toFixed(2)} ({pos.pnlPercent}%)
                        </td>
                        <td className="py-3 px-4 text-right">
                          <button
                            onClick={() => {
                              setPositions(prev => prev.filter(p => p.id !== pos.id));
                              setPortfolio(prev => ({ ...prev, cash: prev.cash + (pos.shares * pos.currentPrice) }));
                            }}
                            className="px-2.5 py-1 bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded text-[11px] hover:bg-rose-500/30"
                          >
                            Close Position
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Execution Trade Audit Log */}
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4">
              <h2 className="font-bold text-sm text-slate-200 uppercase tracking-wide flex items-center space-x-2">
                <FileText className="w-4 h-4 text-emerald-400" />
                <span>Trade Order Execution Log</span>
              </h2>

              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse font-mono text-xs">
                  <thead>
                    <tr className="border-b border-slate-800 text-slate-400">
                      <th className="py-3 px-4">TIMESTAMP</th>
                      <th className="py-3 px-4">ORDER ID</th>
                      <th className="py-3 px-4">TICKER</th>
                      <th className="py-3 px-4">ACTION</th>
                      <th className="py-3 px-4">QTY</th>
                      <th className="py-3 px-4">FILL PRICE</th>
                      <th className="py-3 px-4">TOTAL VALUE</th>
                      <th className="py-3 px-4">STATUS</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60 text-slate-300">
                    {tradeHistory.map((tr) => (
                      <tr key={tr.id} className="hover:bg-slate-800/40">
                        <td className="py-3 px-4 text-slate-400">{tr.timestamp}</td>
                        <td className="py-3 px-4 font-mono text-slate-500">{tr.id}</td>
                        <td className="py-3 px-4 font-bold text-slate-100">{tr.ticker}</td>
                        <td className="py-3 px-4">
                          <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                            tr.action === 'BUY' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'
                          }`}>
                            {tr.action}
                          </span>
                        </td>
                        <td className="py-3 px-4">{tr.qty}</td>
                        <td className="py-3 px-4">${tr.price.toFixed(2)}</td>
                        <td className="py-3 px-4 font-bold text-slate-200">${tr.total.toFixed(2)}</td>
                        <td className="py-3 px-4 text-emerald-400 font-semibold">{tr.status}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        )}

      </main>

      {/* FOOTER STATUS BAR */}
      <footer className="border-t border-slate-800 bg-slate-900/90 px-6 py-2 flex flex-wrap items-center justify-between text-[11px] text-slate-400 font-mono">
        <div className="flex items-center space-x-4">
          <span className="flex items-center space-x-1.5">
            <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Broker API: Connected (Alpaca Paper Router)</span>
          </span>
          <span>•</span>
          <span>Risk Engine: ACTIVE</span>
        </div>
        <div>
          <span>Multi-Agent LLM Capital Simulation Engine</span>
        </div>
      </footer>

    </div>
  );
}
