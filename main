  }
};

// --- INITIAL ASSETS DATA GENERATOR ---
const ASSETS_DATA = {
  AAPL: { name: 'Apple Inc.', price: 185.40, change: '+1.45%', changeVal: 1.45, volatility: 0.012, pe: 28.5, rsi: 54, type: 'EQUITY' },
  NVDA: { name: 'NVIDIA Corp.', price: 124.80, change: '+3.82%', changeVal: 3.82, volatility: 0.028, pe: 64.2, rsi: 68, type: 'EQUITY' },
  TSLA: { name: 'Tesla Inc.', price: 218.50, change: '-2.10%', changeVal: -2.10, volatility: 0.035, pe: 58.1, rsi: 41, type: 'EQUITY' },
  'BTC/USD': { name: 'Bitcoin', price: 64250.00, change: '+2.15%', changeVal: 2.15, volatility: 0.032, pe: 'N/A', rsi: 62, type: 'CRYPTO' },
  'ETH/USD': { name: 'Ethereum', price: 3480.00, change: '+0.85%', changeVal: 0.85, volatility: 0.030, pe: 'N/A', rsi: 51, type: 'CRYPTO' }
};

// --- NEWS HEADLINES FOR SENTIMENT SIMULATION ---
const SIMULATED_NEWS = {
  AAPL: [
    "Apple announces breakthrough in AI chips for next iPhone generation.",
    "Supply chain reports suggest strong demand for premium MacBooks.",
    "EU regulator requests clarification on App Store fee compliance.",
    "Analyst upgrades AAPL target price to $210 citing services growth."
  ],
  NVDA: [
    "NVIDIA unveils next-gen Blackwell architecture with 3x efficiency gains.",
    "Hyperscalers increase AI infrastructure capex budgets by 25%.",
    "Export restrictions update causes temporary uncertainty in overseas markets.",
    "Major cloud provider orders $2B worth of GPU clusters."
  ],
  TSLA: [
    "Tesla Robotaxi event date confirmed with live public demo scheduled.",
    "Q3 vehicle delivery numbers slightly miss consensus estimates.",
    "Energy storage deployment breaks quarterly record up 150% YoY.",
    "EV price competition intensifies in primary international markets."
  ],
  'BTC/USD': [
    "Spot Bitcoin ETF inflows hit new single-day record of $450M.",
    "Institutional adoption surges as sovereign wealth fund allocates 1%.",
    "On-chain metrics show long-term holders accumulating at key support.",
    "Mining difficulty adjusts upward +3.5% reflecting network hash power."
  ],
  'ETH/USD': [
    "Layer 2 network activity reaches all-time high transactions per second.",
    "Ethereum staking yield stabilizes at 3.8% with total staked passing 32M ETH.",
    "Major DeFi protocol upgrade reduces gas overhead by 40%.",
    "Institutional treasury announces $100M Ethereum allocation."
  ]
};

export default function App() {
  // --- STATE MANAGEMENT ---
  const [activeTab, setActiveTab] = useState('dashboard'); // dashboard | studio | map | risk | history
  const [selectedAsset, setSelectedAsset] = useState('NVDA');
  const [agents, setAgents] = useState(INITIAL_AGENTS);
  const [selectedAgentNode, setSelectedAgentNode] = useState('portfolio_manager');
  
  // Simulation Controls
  const [isRunning, setIsRunning] = useState(false);
  const [simSpeed, setSimSpeed] = useState(2000); // 2 seconds
  const [tickCount, setTickCount] = useState(1);
  const [selectedApiKey, setSelectedApiKey] = useState('');
  const [useLiveLLM, setUseLiveLLM] = useState(false);

  // Portfolio State
  const [portfolio, setPortfolio] = useState({
    cash: 250000.00,
    equity: 250000.00,
    startBalance: 250000.00,
    pnl: 0,
    pnlPercent: 0,
    winRate: 72.5,
    totalTrades: 18,
    winningTrades: 13,
    maxDrawdown: 2.1
  });

  const [positions, setPositions] = useState([
    { id: 'pos-1', ticker: 'NVDA', shares: 200, entryPrice: 118.50, currentPrice: 124.80, pnl: 1260.00, pnlPercent: 5.31, stopLoss: 115.00, takeProfit: 135.00 },
    { id: 'pos-2', ticker: 'AAPL', shares: 300, entryPrice: 182.10, currentPrice: 185.40, pnl: 990.00, pnlPercent: 1.81, stopLoss: 178.00, takeProfit: 195.00 }
  ]);

  // Risk Rules State
  const [riskRules, setRiskRules] = useState({
    maxPositionSizePercent: 15, // Max 15% of portfolio per position
    maxDrawdownThreshold: 8.0, // Max 8% portfolio drawdown before kill-switch
    defaultStopLossPercent: 3.5,
    defaultTakeProfitPercent: 8.0,
    riskTolerance: 'BALANCED', // CONSERVATIVE | BALANCED | AGGRESSIVE
    requireCroApproval: true,
    maxDailyTrades: 10
  });

  // Price Charts Data state
  const [priceHistory, setPriceHistory] = useState(() => {
    const basePrice = ASSETS_DATA['NVDA'].price;
    const history = [];
    let curPrice = basePrice * 0.92;
    for (let i = 30; i >= 0; i--) {
      curPrice += (Math.random() - 0.48) * (curPrice * 0.015);
      history.push({
        time: `${30 - i}m ago`,
        price: parseFloat(curPrice.toFixed(2)),
        sma: parseFloat((curPrice * 0.99).toFixed(2)),
        upperBand: parseFloat((curPrice * 1.02).toFixed(2)),
        lowerBand: parseFloat((curPrice * 0.98).toFixed(2))
      });
    }
    return history;
  });

  // Agent Thoughts / Deliberation Feed
  const [deliberationLogs, setDeliberationLogs] = useState([]);
  const [tradeHistory, setTradeHistory] = useState([
    { id: 'tr-101', timestamp: '10:42:15 AM', ticker: 'NVDA', action: 'BUY', qty: 200, price: 118.50, total: 23700.00, status: 'FILLED', agentApproval: 'Approved by PM & Risk Mgr' },
    { id: 'tr-100', timestamp: '09:31:05 AM', ticker: 'AAPL', action: 'BUY', qty: 300, price: 182.10, total: 54630.00, status: 'FILLED', agentApproval: 'Approved by PM & Risk Mgr' }
  ]);

  const logsEndRef = useRef(null);

  // --- AUTO SCROLL LOGS ---
  useEffect(() => {
    if (logsEndRef.current) {
      logsEndRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [deliberationLogs]);

  // --- REGENERATE PRICE CHART ON ASSET SWITCH ---
  useEffect(() => {
    const basePrice = ASSETS_DATA[selectedAsset].price;
    const newHistory = [];
    let curPrice = basePrice * 0.93;
    for (let i = 30; i >= 0; i--) {
      curPrice += (Math.random() - 0.48) * (curPrice * (ASSETS_DATA[selectedAsset].volatility || 0.02));
      newHistory.push({
        time: `${30 - i}m ago`,
        price: parseFloat(curPrice.toFixed(2)),
        sma: parseFloat((curPrice * 0.995).toFixed(2)),
        upperBand: parseFloat((curPrice * 1.025).toFixed(2)),
        lowerBand: parseFloat((curPrice * 0.975).toFixed(2))
      });
    }
    setPriceHistory(newHistory);
  }, [selectedAsset]);

  // --- SIMULATION STEP ENGINE ---
  const runSimulationTick = async () => {
    setTickCount(prev => prev + 1);
    const asset = ASSETS_DATA[selectedAsset];
    
    // 1. Update Asset Price
    const volatility = asset.volatility;
    const priceChangePct = (Math.random() - 0.49) * volatility;
    const newPrice = Math.max(1.0, parseFloat((asset.price * (1 + priceChangePct)).toFixed(2)));
    asset.price = newPrice;
    asset.changeVal = parseFloat((asset.changeVal + priceChangePct * 100).toFixed(2));
    asset.change = `${asset.changeVal >= 0 ? '+' : ''}${asset.changeVal.toFixed(2)}%`;

    // Append to price history
    setPriceHistory(prev => {
      const updated = [...prev.slice(1)];
      const lastSma = prev[prev.length - 1]?.sma || newPrice;
      const newSma = parseFloat((lastSma * 0.8 + newPrice * 0.2).toFixed(2));
      updated.push({
        time: 'Just now',
        price: newPrice,
        sma: newSma,
        upperBand: parseFloat((newSma * 1.03).toFixed(2)),
        lowerBand: parseFloat((newSma * 0.97).toFixed(2))
      });
      return updated;
    });

    // 2. Generate Agent Deliberation Pipeline
    const timestamp = new Date().toLocaleTimeString();
    
    // Step A: Quant Agent Analysis
    const rsiVal = Math.floor(30 + Math.random() * 45);
    const macdHist = (Math.random() - 0.45).toFixed(2);
    const quantAction = rsiVal < 40 || macdHist > 0.2 ? 'BUY' : (rsiVal > 65 ? 'SELL' : 'HOLD');
    const quantScore = quantAction === 'BUY' ? (0.4 + Math.random() * 0.5).toFixed(2) : (quantAction === 'SELL' ? (-0.4 - Math.random() * 0.5).toFixed(2) : (Math.random() * 0.3 - 0.15).toFixed(2));
    const quantReasoning = `RSI(14) at ${rsiVal}. MACD Histogram ${macdHist}. ${quantAction === 'BUY' ? 'Bullish divergence forming on 5m chart.' : (quantAction === 'SELL' ? 'Overbought conditions near resistance.' : 'Consolidation phase detected.')}`;

    // Step B: Sentiment Agent Analysis
    const headlines = SIMULATED_NEWS[selectedAsset];
    const pickedHeadline = headlines[Math.floor(Math.random() * headlines.length)];
    const sentimentScore = (Math.random() * 1.2 - 0.4).toFixed(2); // -0.4 to 0.8
    const sentimentAction = sentimentScore > 0.3 ? 'BUY' : (sentimentScore < -0.2 ? 'SELL' : 'HOLD');
    const sentimentReasoning = `News Analysis: "${pickedHeadline}" -> Polarity score: ${sentimentScore}. Sentiment skew is ${sentimentAction.toLowerCase()}ish.`;

    // Step C: Fundamental Agent Analysis
    const fundScore = asset.pe === 'N/A' ? 0.25 : (asset.pe < 35 ? 0.5 : -0.2);
    const fundAction = fundScore > 0.2 ? 'BUY' : (fundScore < -0.1 ? 'SELL' : 'HOLD');
    const fundReasoning = `Valuation metric evaluation: P/E: ${asset.pe}. Balance sheet health index 8.4/10. Intrinsic value estimate aligned with long position thesis.`;

    // Step D: Portfolio Manager Synthesis (Weighted)
    const weightedScore = (
      quantScore * agents.quant.weight + 
      sentimentScore * agents.sentiment.weight + 
      fundScore * agents.fundamental.weight
    ).toFixed(2);

    let pmAction = 'HOLD';
    if (weightedScore > 0.25) pmAction = 'BUY';
    else if (weightedScore < -0.25) pmAction = 'SELL';

    const pmReasoning = `Weighted Signal Aggregation (${weightedScore}). Quant: ${quantScore}, Sentiment: ${sentimentScore}, Fundamental: ${fundScore}. Consensus proposal: ${pmAction}.`;

    // Step E: Risk Manager Inspection
    let riskApproved = true;
    let riskReason = 'Trade complies with maximum allocation rule (15%) and VaR boundaries.';
    
    // Risk check simulation
    if (pmAction !== 'HOLD') {
      const positionValue = (portfolio.equity * (riskRules.maxPositionSizePercent / 100));
      if (positionValue > portfolio.cash && pmAction === 'BUY') {
        riskApproved = false;
        riskReason = `VETO: Insufficient cash buffer (${portfolio.cash.toFixed(2)}) for full position size.`;
      } else if (portfolio.maxDrawdown > riskRules.maxDrawdownThreshold) {
        riskApproved = false;
        riskReason = `VETO: Maximum portfolio drawdown trigger active (${portfolio.maxDrawdown}% > ${riskRules.maxDrawdownThreshold}%).`;
      }
    }

    // Step F: Execution Step (If Approved & Trade Recommended)
    let executionLog = null;
    if (pmAction !== 'HOLD' && riskApproved) {
      const orderQty = Math.floor((portfolio.cash * 0.1) / newPrice) || 5;
      const tradeVal = orderQty * newPrice;
      
      executionLog = {
        id: `tr-${Date.now().toString().slice(-4)}`,
        timestamp,
        ticker: selectedAsset,
        action: pmAction,
        qty: orderQty,
        price: newPrice,
        total: tradeVal,
        status: 'FILLED',
        agentApproval: 'Approved by PM & CRO'
      };

      // Execute order state update
      setTradeHistory(prev => [executionLog, ...prev]);

      if (pmAction === 'BUY') {
        setPortfolio(prev => ({
          ...prev,
          cash: prev.cash - tradeVal,
          totalTrades: prev.totalTrades + 1
        }));

        setPositions(prev => {
          const existing = prev.find(p => p.ticker === selectedAsset);
          if (existing) {
            const newShares = existing.shares + orderQty;
            const newAvg = ((existing.shares * existing.entryPrice) + tradeVal) / newShares;
            return prev.map(p => p.ticker === selectedAsset ? {
              ...p,
              shares: newShares,
              entryPrice: parseFloat(newAvg.toFixed(2)),
              currentPrice: newPrice
            } : p);
          } else {
            return [...prev, {
              id: `pos-${Date.now()}`,
              ticker: selectedAsset,
              shares: orderQty,
              entryPrice: newPrice,
              currentPrice: newPrice,
              pnl: 0,
              pnlPercent: 0,
              stopLoss: parseFloat((newPrice * (1 - riskRules.defaultStopLossPercent / 100)).toFixed(2)),
              takeProfit: parseFloat((newPrice * (1 + riskRules.defaultTakeProfitPercent / 100)).toFixed(2))
            }];
          }
        });
      }
    }

    // Update Agent States in memory
    setAgents(prev => ({
      ...prev,
      quant: { ...prev.quant, status: 'active', lastSignal: { action: quantAction, score: quantScore, reasoning: quantReasoning } },
      sentiment: { ...prev.sentiment, status: 'active', lastSignal: { action: sentimentAction, score: sentimentScore, reasoning: sentimentReasoning } },
      fundamental: { ...prev.fundamental, status: 'active', lastSignal: { action: fundAction, score: fundScore, reasoning: fundReasoning } },
      portfolio_manager: { ...prev.portfolio_manager, status: 'active', lastSignal: { action: pmAction, score: weightedScore, reasoning: pmReasoning } },
      risk_manager: { ...prev.risk_manager, status: 'active', lastSignal: { action: riskApproved ? 'APPROVED' : 'VETOED', score: riskApproved ? 1.0 : 0.0, reasoning: riskReason } },
      execution: { ...prev.execution, status: executionLog ? 'active' : 'idle', lastSignal: executionLog ? { action: 'EXECUTED', score: 1.0, reasoning: `Executed ${executionLog.action} ${executionLog.qty} @ $${executionLog.price}` } : prev.execution.lastSignal }
    }));

    // Update positions current prices
    setPositions(prev => prev.map(pos => {
      const currentVal = pos.shares * (pos.ticker === selectedAsset ? newPrice : pos.currentPrice);
      const entryVal = pos.shares * pos.entryPrice;
      const pnl = currentVal - entryVal;
      const pnlPercent = (pnl / entryVal) * 100;
      return {
        ...pos,
        currentPrice: pos.ticker === selectedAsset ? newPrice : pos.currentPrice,
        pnl: parseFloat(pnl.toFixed(2)),
        pnlPercent: parseFloat(pnlPercent.toFixed(2))
      };
    }));

    // Append batch to Deliberation Logs
    const logBatch = {
      id: `tick-${Date.now()}`,
      timestamp,
      tick: tickCount,
      ticker: selectedAsset,
      price: newPrice,
      quant: { action: quantAction, score: quantScore, text: quantReasoning },
      sentiment: { action: sentimentAction, score: sentimentScore, text: sentimentReasoning },
      fundamental: { action: fundAction, score: fundScore, text: fundReasoning },
      pm: { action: pmAction, score: weightedScore, text: pmReasoning },
      risk: { approved: riskApproved, text: riskReason },
      execution: executionLog
    };

    setDeliberationLogs(prev => [...prev.slice(-40), logBatch]);
  };

  // Auto Tick Timer Loop
  useEffect(() => {
    let timer;
    if (isRunning) {
      timer = setInterval(() => {
        runSimulationTick();
      }, simSpeed);
    }
    return () => clearInterval(timer);
  }, [isRunning, simSpeed, selectedAsset, portfolio, riskRules, agents]);

  // Recalculate Portfolio Total Equity
  useEffect(() => {
    const totalPosVal = positions.reduce((acc, pos) => acc + (pos.shares * pos.currentPrice), 0);
    const newEquity = portfolio.cash + totalPosVal;
    const totalPnl = newEquity - portfolio.startBalance;
    const totalPnlPct = (totalPnl / portfolio.startBalance) * 100;

    setPortfolio(prev => ({
      ...prev,
      equity: parseFloat(newEquity.toFixed(2)),
      pnl: parseFloat(totalPnl.toFixed(2)),
      pnlPercent: parseFloat(totalPnlPct.toFixed(2))
    }));
  }, [positions, portfolio.cash]);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans border-t-4 border-emerald-500 selection:bg-emerald-500 selection:text-slate-950">
      
      {/* HEADER BAR */}
      <header className="border-b border-slate-800 bg-slate-900/80 backdrop-blur px-6 py-3 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-50">
        <div className="flex items-center space-x-3">
          <div className="p-2 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400">
            <Cpu className="w-6 h-6 animate-pulse" />
          </div>
          <div>
            <div className="flex items-center space-x-2">
              <h1 className="font-bold text-lg tracking-wider text-slate-100 uppercase">Aethelgard AI Capital</h1>
              <span className="text-xs px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-mono">
                Multi-Agent LLM Firm v2.4
              </span>
            </div>
            <p className="text-xs text-slate-400">Autonomous Quantitative & Fundamental Multi-Agent Trading System</p>
          </div>
        </div>

        {/* Global Control Bar */}
        <div className="flex items-center space-x-3">
          {/* Tick Controls */}
          <div className="flex items-center bg-slate-950 border border-slate-800 rounded-lg p-1 space-x-1">
            <button
              onClick={() => setIsRunning(!isRunning)}
              className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-all ${
                isRunning 
                  ? 'bg-amber-500/20 text-amber-400 hover:bg-amber-500/30 border border-amber-500/30' 
                  : 'bg-emerald-500 text-slate-950 hover:bg-emerald-400 font-bold'
              }`}
            >
              {isRunning ? <Pause className="w-3.5 h-3.5" /> : <Play className="w-3.5 h-3.5" />}
              <span>{isRunning ? 'Pause Engine' : 'Start Auto-Tick'}</span>
            </button>

            <button
              onClick={runSimulationTick}
              disabled={isRunning}
              className="px-2.5 py-1.5 rounded-md text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 disabled:opacity-40 flex items-center space-x-1"
              title="Manual Step"
            >
              <SkipForward className="w-3.5 h-3.5" />
              <span>Step</span>
            </button>
          </div>

          {/* Tick Speed Selector */}
          <div className="flex items-center bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs space-x-2">
            <Clock className="w-3.5 h-3.5 text-slate-400" />
            <select
              value={simSpeed}
              onChange={(e) => setSimSpeed(Number(e.target.value))}
              className="bg-transparent text-slate-300 focus:outline-none text-xs font-mono"
            >
              <option value={1000}>1s Tick</option>
              <option value={2000}>2s Tick</option>
              <option value={5000}>5s Tick</option>
            </select>
          </div>

          {/* Gemini API Switcher */}
          <button
            onClick={() => {
              const key = prompt('Enter Google Gemini API Key (Optional for real LLM reasoning):', selectedApiKey);
              if (key !== null) {
                setSelectedApiKey(key);
                setUseLiveLLM(!!key);
              }
            }}
            className={`flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg border text-xs font-mono transition-all ${
              useLiveLLM 
                ? 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40' 
                : 'bg-slate-800/60 text-slate-400 border-slate-700 hover:border-slate-600'
            }`}
          >
            <Sparkles className="w-3.5 h-3.5 text-indigo-400" />
            <span>{useLiveLLM ? 'Live Gemini 3.1 Active' : 'Simulated LLM Engine'}</span>
          </button>
        </div>
      </header>

      {/* TOP METRICS STRIP */}
