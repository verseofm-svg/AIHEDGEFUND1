import React, { useState, useEffect, useRef } from 'react';
import { 
  TrendingUp, TrendingDown, Shield, Cpu, Activity, DollarSign, 
  Settings, Play, Pause, SkipForward, RefreshCw, Layers, Brain, 
  CheckCircle, AlertTriangle, XCircle, FileText, BarChart2, PieChart, 
  Maximize2, Zap, ArrowRight, Lock, Eye, Sliders, Terminal, HelpCircle,
  Clock, Database, Sparkles, Key
} from 'lucide-react';
import { 
  ResponsiveContainer, AreaChart, Area, XAxis, YAxis, Tooltip, 
  CartesianGrid, LineChart, Line, BarChart, Bar, Legend 
} from 'recharts';

// --- INITIAL DEFAULT AGENT PROMPTS & CONFIGS ---
const INITIAL_AGENTS = {
  quant: {
    id: 'quant',
    name: 'Quant & Technical Agent',
    role: 'Analyzes technical indicators (RSI, MACD, Moving Averages, Volatility) to quantify short-term momentum and statistical edge.',
    color: '#3b82f6',
    model: 'gemini-3.1-flash-preview',
    temperature: 0.2,
    weight: 0.35,
    prompt: `You are the Lead Quantitative Analyst at a hedge fund. Your job is to analyze quantitative data (RSI, MACD, SMA, Bollinger Bands, Volume) and produce a strictly numerical signal between -1.0 (Strong Short) and +1.0 (Strong Long) with technical rationale. Avoid qualitative fluff.`,
    status: 'idle',
    memory: ['RSI oversold signals verified on 1H frame', 'Volatility spike detected during market open'],
    lastSignal: { action: 'BUY', score: 0.65, reasoning: 'RSI divergence detected at 38.2% Fibonacci support.' }
  },
  sentiment: {
    id: 'sentiment',
    name: 'Sentiment & News Agent',
    role: 'Monitors real-time breaking news, earnings transcripts, social media sentiment, and macroeconomic announcements.',
