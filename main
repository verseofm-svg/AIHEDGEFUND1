  },
  fundamental: {
    id: 'fundamental',
    name: 'Fundamental & Valuation Agent',
    role: 'Evaluates balance sheets, P/E ratios, free cash flow, competitive moat, and long-term intrinsic value.',
    color: '#8b5cf6',
    model: 'gemini-3.1-flash-preview',
    temperature: 0.3,
    weight: 0.20,
    prompt: `You are the Fundamental Equity Analyst. Assess current valuation metrics (P/E, EV/EBITDA, Debt-to-Equity, FCF Yield) relative to historical averages and sector peers. Output score -1.0 to +1.0 with valuation thesis.`,
    status: 'idle',
    memory: ['P/E ratio 12% below 5-year average', 'FCF margin remains strong at 28%'],
    lastSignal: { action: 'HOLD', score: 0.15, reasoning: 'Fairly valued relative to 5-year historical average; strong cash balances.' }
  },
  portfolio_manager: {
    id: 'portfolio_manager',
    name: 'Portfolio Manager Agent',
    role: 'Synthesizes weighted recommendations from Quant, Sentiment, and Fundamental agents into a unified strategic trade proposal.',
    color: '#10b981',
    model: 'gemini-3.1-flash-preview',
    temperature: 0.2,
    weight: 1.0,
    prompt: `You are the Chief Investment Officer / Portfolio Manager. Synthesize signals from the Quant, Sentiment, and Fundamental agents based on their assigned weights. Formulate an actionable trade proposal (BUY, SELL, HOLD) with target allocation percentage and confidence level.`,
    status: 'idle',
    memory: ['Overweight tech exposure authorized', 'Rebalancing target cash reserve to 15%'],
    lastSignal: { action: 'BUY', score: 0.62, reasoning: 'Strong consensus between Quant and Sentiment agents outweighs neutral Fundamental valuation.' }
  },
  risk_manager: {
    id: 'risk_manager',
    name: 'Risk Management Agent',
    role: 'Enforces hard programmatic and LLM guardrails: Max Drawdown, Position Size Limits, VaR, Stop-Loss and Veto power.',
    color: '#f59e0b',
    model: 'gemini-3.1-flash-preview',
    temperature: 0.1,
    weight: 1.0, // Absolute veto power
    prompt: `You are the Chief Risk Officer (CRO). You possess absolute veto authority. Review proposed trades against current portfolio risk parameters: Max Position Size, Drawdown Limits, Volatility Limits, and Stop Losses. Approve, Reject, or Trim the position size.`,
    status: 'idle',
    memory: ['Max single position capped at 20%', 'Portfolio Drawdown limit at 8%'],
    lastSignal: { action: 'APPROVED', score: 1.0, reasoning: 'Trade fits within 15% allocation limit and VaR boundary. Dynamic Stop-Loss set at 3.5%.' }
  },
  execution: {
    id: 'execution',
    name: 'Execution Broker Agent',
    role: 'Simulates smart order routing (Alpaca/IBKR API), calculating slippage, commission, and fill price execution.',
    color: '#06b6d4',
    model: 'Deterministic Engine',
    temperature: 0.0,
    weight: 1.0,
    prompt: `Execute approved trade via Broker API using TWAP/VWAP logic. Calculate fill price with simulated slippage and commission costs.`,
    status: 'idle',
    memory: ['API latency average 24ms', 'Alpaca paper trading route active'],
